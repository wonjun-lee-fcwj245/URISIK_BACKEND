+package com.urisik.backend.domain.review.service;
+
+import com.urisik.backend.domain.review.dto.ReviewRequestDto;
+import com.urisik.backend.domain.review.dto.ReviewResponseDto;
+import lombok.RequiredArgsConstructor;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.dao.PessimisticLockingFailureException;
+import org.springframework.stereotype.Service;
+
+/**
+ * [실험용] 트랜잭션 밖에서 재시도하는 래퍼. 호출마다 reviewService.createReview가 새 트랜잭션으로 실행된다.
+ */
+@Service
+@RequiredArgsConstructor
+public class ReviewRetryFacade {
+
+    private final ReviewService reviewService;
+
+    @Value("${review.retry.mode:none}")
+    private String retryMode;
+    @Value("${review.retry.max:3}")
+    private int retryMax;
+
+    public ReviewResponseDto createReview(ReviewRequestDto requestDto, Long memberId, Long recipeId) {
+        if (!"outside".equals(retryMode)) {
+            return reviewService.createReview(requestDto, memberId, recipeId);
+        }
+        for (int attempt = 1; ; attempt++) {
+            try {
+                return reviewService.createReview(requestDto, memberId, recipeId);
+            } catch (PessimisticLockingFailureException e) {
+                if (attempt >= retryMax) {
+                    throw e;
+                }
+                try {
+                    Thread.sleep(10L * attempt + (long) (Math.random() * 40));
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                    throw e;
+                }
+            }
+        }
+    }
+}
